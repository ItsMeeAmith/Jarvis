# JARVIS AI Assistant — Environment Variables
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── AI ───────────────────────────────────────────────────
# Get your free key at https://console.groq.com
GROQ_API_KEY=your_groq_key_here

# ── Database ─────────────────────────────────────────────
DB_PASSWORD=choose_a_strong_password
DATABASE_URL=postgresql://postgres:choose_a_strong_password@db:5432/jarvis

# ── Cache ────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ── Optional integrations ────────────────────────────────
# Leave blank to use the free DuckDuckGo search fallback
SERPAPI_KEY=

# Leave blank to disable weather tool
OPENWEATHER_KEY=

# ── Frontend ─────────────────────────────────────────────
# Set to your DigitalOcean Droplet IP or domain
NEXT_PUBLIC_API_URL=http://your-droplet-ip
